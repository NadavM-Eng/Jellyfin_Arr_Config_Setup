# ============================================================
# Jellyfin Quick Setup - Environment Configuration
# ============================================================

# ------------------------------------------------------------
# Core
# ------------------------------------------------------------

PUID=1000
PGID=1000
TZ=Asia/Jerusalem

# Main application configuration directory
CONFIG_ROOT=./config

# Main media/download data directory
DATA_ROOT=./data


# ------------------------------------------------------------
# Reverse Proxy - Nginx Proxy Manager
# ------------------------------------------------------------

NPM_HTTP_PORT=80
NPM_HTTPS_PORT=4443
NPM_ADMIN_PORT=81


# ------------------------------------------------------------
# DuckDNS
# ------------------------------------------------------------

DUCKDNS_SUBDOMAINS=
DUCKDNS_TOKEN=


# ------------------------------------------------------------
# Media Management Stack
# ------------------------------------------------------------

JELLYFIN_PORT=8096
SONARR_PORT=8989
RADARR_PORT=7878
BAZARR_PORT=6767
PROWLARR_PORT=9696

# ==============================================================================
# Prowlarr Private Indexers
# ==============================================================================
# Leave blank to skip an indexer.
#
# Fill these values in your *personal* .env file.

ANIMETOSHO_API_KEY=
FUZER_COOKIE=
HEBITS_COOKIE=


# ------------------------------------------------------------
# qBittorrent
# ------------------------------------------------------------

QBITTORRENT_WEBUI_PORT=8080
QBITTORRENT_TORRENTING_PORT=6881
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=


# ------------------------------------------------------------
# Seerr
# ------------------------------------------------------------

SEERR_PORT=5055
SEERR_LOG_LEVEL=debug


# ------------------------------------------------------------
# TRAWL
# ------------------------------------------------------------

# Number of warm browser instances
TRAWL_BROWSER_POOL_SIZE=1

# Optional upstream proxy
TRAWL_PROXY_URL=

# Optional residential proxy
TRAWL_RESIDENTIAL_PROXY_URL=

# Advanced MITM proxy - disabled by default
TRAWL_MITM_ENABLED=false

# 3 prevents automatic escalation to a residential proxy
TRAWL_MITM_MAX_TIER=3

TRAWL_MITM_DEBUG=false
